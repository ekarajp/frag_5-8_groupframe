# Copy to .env next to compose.yml (see docs/DEPLOY_UBUNTU.md)
# Host interface the dashboard port is published on. Default loopback; 0.0.0.0 = all interfaces.
FRAGILITY_BIND=127.0.0.1
# Comma-separated exact Host:port values the dashboard accepts for LAN/VLAN access.
# 127.0.0.1:<port> is always allowed; IPv6 literals use bracket form [2001:db8::5]:8788.
FRAGILITY_ALLOWED_HOSTS=
# Container CPU quota (float). Leaves cores for other work on the host; also set the
# dashboard Workers count to about this minus one when Starting a campaign.
FRAGILITY_CPUS=10
